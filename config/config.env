# Istio / k8s / k3s compatibility matrix
# Istio supports the 4 most recent k8s minor versions at release time.
# Recommended k3s = highest supported k8s minor with a stable k3s release.
# Verify latest patch: https://github.com/k3s-io/k3s/releases
#
#  Istio  │ k8s range  │ rec. k8s │ k3s
# --------┼────────────┼──────────┼──────────────────
#  1.13.x │ 1.22–1.24  │  1.24    │ v1.24.17+k3s1
#  1.14.x │ 1.21–1.24  │  1.24    │ v1.24.17+k3s1
#  1.15.x │ 1.22–1.25  │  1.25    │ v1.25.16+k3s4
#  1.16.x │ 1.22–1.26  │  1.26    │ v1.26.15+k3s1
#  1.17.x │ 1.23–1.26  │  1.26    │ v1.26.15+k3s1
#  1.18.x │ 1.24–1.27  │  1.27    │ v1.27.16+k3s1
#  1.19.x │ 1.25–1.28  │  1.28    │ v1.28.15+k3s1
#  1.20.x │ 1.25–1.28  │  1.28    │ v1.28.15+k3s1
#  1.21.x │ 1.26–1.29  │  1.29    │ v1.29.14+k3s1
#  1.22.x │ 1.27–1.30  │  1.30    │ v1.30.10+k3s1
#  1.23.x │ 1.28–1.31  │  1.31    │ v1.31.6+k3s1
#  1.24.x │ 1.28–1.31  │  1.29    │ v1.29.4+k3s1
#  1.25.x │ 1.29–1.32  │  1.32    │ v1.32.5+k3s1
#  1.26.x │ 1.30–1.33  │  1.33    │ v1.33.1+k3s1
#  1.27.x │ 1.31–1.34  │  1.33    │ v1.33.1+k3s1
#  1.28.x │ 1.32–1.35  │  1.33    │ v1.33.1+k3s1
#  1.29.x │ 1.33–1.35  │  1.33    │ v1.33.1+k3s1
declare -A _ISTIO_K3S_MAP=(
  [1.13]=v1.24.17+k3s1
  [1.14]=v1.24.17+k3s1
  [1.15]=v1.25.16+k3s4
  [1.16]=v1.26.15+k3s1
  [1.17]=v1.26.15+k3s1
  [1.18]=v1.27.16+k3s1
  [1.19]=v1.28.15+k3s1
  [1.20]=v1.28.15+k3s1
  [1.21]=v1.29.14+k3s1
  [1.22]=v1.30.10+k3s1
  [1.23]=v1.31.6+k3s1
  [1.24]=v1.29.4+k3s1
  [1.25]=v1.32.5+k3s1
  [1.26]=v1.33.1+k3s1
  [1.27]=v1.33.1+k3s1
  [1.28]=v1.33.1+k3s1
  [1.29]=v1.33.1+k3s1
)
istio_version="${ISTIO_VERSION:-1.24.0}"
export istio_label=$(echo "$istio_version" | tr '.' '-')
_istio_minor=$(echo "$istio_version" | cut -d. -f1-2)
K3S_VERSION="${K3S_VERSION:-${_ISTIO_K3S_MAP[$_istio_minor]:-v1.29.4+k3s1}}"

KUBECONFIG=/etc/rancher/k3s/k3s.yaml

FOLDER_PATH_download=/tmp/k3s-sandbox
FOLDER_PATH_istio=/tmp/k3s-sandbox/istio-${istio_version}
