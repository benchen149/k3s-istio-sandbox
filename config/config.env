# Istio / k3s version compatibility:
#   Istio 1.13.5 → k8s 1.22–1.25 → k3s v1.24.17+k3s1
#   Istio 1.24.0 → k8s 1.28–1.31 → k3s v1.29.4+k3s1
#   Istio 1.29.2 → k8s 1.33–1.35 → k3s v1.33.1+k3s1
istio_version="${ISTIO_VERSION:-1.24.0}"
export istio_label=$(echo "$istio_version" | tr '.' '-')

K3S_VERSION="${K3S_VERSION:-v1.29.4+k3s1}"

KUBECONFIG=/etc/rancher/k3s/k3s.yaml

FOLDER_PATH_download=/tmp/k3s-sandbox
FOLDER_PATH_istio=/tmp/k3s-sandbox/istio-${istio_version}
